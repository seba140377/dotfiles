<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install_tagesplanung.sh replaces __BIN__ and __HOME__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.seba140377.tagesplanung</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__/tagesplanung-run</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/tagesplanung.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/tagesplanung.log</string>
</dict>
</plist>
