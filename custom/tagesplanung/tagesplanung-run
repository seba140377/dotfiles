#!/bin/bash
# Runs the vault skills `tagesplanung` and `wochenrueckblick` unattended via
# `claude -p` (launchd routine).
# Usage: tagesplanung-run [heute|morgen|woche|rueckblick]
#   no mode: from 12:00 `morgen` (+ `rueckblick`, `woche` on Sundays); before
#   12:00, i.e. a run launchd caught up after midnight, `heute` (+ `rueckblick`,
#   `woche` on Mondays). `rueckblick` reviews the week ending on the last Sunday.
# Exit: 0 ok, 1 a run failed or invalid mode, 2 macOS access for ekread missing.
# Overridable for tests: TP_VAULT TP_CLAUDE TP_NOTIFY TP_LOG TP_NOW ("YYYY-MM-DD HH:MM")
#   TP_TIMEOUT (seconds per claude run) TP_PATH_PREFIX

set -euo pipefail

TP_VAULT="${TP_VAULT:-/Users/seba/projects/seba140377/src/claude-code-os}"
TP_CLAUDE="${TP_CLAUDE:-claude}"
TP_NOTIFY="${TP_NOTIFY:-}"
TP_LOG="${TP_LOG:-$HOME/Library/Logs/tagesplanung.log}"
TP_TIMEOUT="${TP_TIMEOUT:-600}"
KEEP_RUNS=30

# launchd starts without a login shell
PATH="${TP_PATH_PREFIX:+$TP_PATH_PREFIX:}$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# With --permission-mode dontAsk everything not listed here is denied: the run
# reads mail from strangers, so nothing may reach the network except Gmail
# search and a push to the vault's own remote.
TOOLS=(
  "Bash(ekread:*)" Read Grep Glob "Edit(plans/**)" "Bash(mkdir:*)" "Bash(date:*)"
  mcp__claude_ai_Gmail__search_threads
  "Bash(git add:*)" "Bash(git diff:*)" "Bash(git commit:*)"
  "Bash(git push)" "Bash(git push origin main)"
)
# The weekly review reads no mail but runs the read-only git activity script.
REVIEW_TOOLS=("Bash(.claude/skills/wochenrueckblick/git-activity:*)")
for t in "${TOOLS[@]}"; do
  [ "$t" = mcp__claude_ai_Gmail__search_threads ] || REVIEW_TOOLS+=("$t")
done
WEEKDAYS=(_ Montag Dienstag Mittwoch Donnerstag Freitag Samstag Sonntag)

now="${TP_NOW:-$(date '+%F %H:%M')}"
today="${now% *}"
hour=$((10#$(echo "${now#* }" | cut -d: -f1)))
started="${today}T${now#* }"   # plan files must be generated at or after this
dow=$(date -j -f %F "$today" +%u)

notify() {
  if [ -n "$TP_NOTIFY" ]; then
    "$TP_NOTIFY" "$1"
  else
    osascript -e "display notification \"$1\" with title \"Tagesplanung\"" || true
  fi
}

day_offset() { date -j -v"$2"d -f %F "$1" +%F; }

# trim_log: keep the last KEEP_RUNS runs (each starts with a "=== " line)
# shellcheck disable=SC2329 # invoked via trap
trim_log() {
  [ -f "$TP_LOG" ] || return 0
  local runs from
  runs=$(grep -c '^=== ' "$TP_LOG" || true)
  [ "$runs" -gt "$KEEP_RUNS" ] || return 0
  from=$(grep -n '^=== ' "$TP_LOG" | sed -n "$((runs - KEEP_RUNS + 1))p" | cut -d: -f1)
  tail -n +"$from" "$TP_LOG" >"$TP_LOG.tmp" && mv "$TP_LOG.tmp" "$TP_LOG"
}

# plan_day <mode>: the day the plan file is named after (week: a day in that week)
plan_day() {
  case "$1" in
    heute) echo "$today" ;;
    morgen) day_offset "$today" +1 ;;
    woche) if [ "$dow" = 7 ]; then day_offset "$today" +1; else echo "$today"; fi ;;
    rueckblick) if [ "$dow" = 1 ]; then day_offset "$today" -1; else echo "$today"; fi ;;
  esac
}

week_of() { date -j -f %F "$1" +%G-W%V; }
week_number() { echo $((10#$(date -j -f %F "$1" +%V))); }

prompt_for() {
  if [ "$1" = rueckblick ]; then
    echo "/wochenrueckblick --routine"
  else
    echo "/tagesplanung $1 --routine"
  fi
}

target_file() {
  local d
  d=$(plan_day "$1")
  if [ "$1" = woche ]; then
    echo "plans/$(week_of "$d") Wochenplan.md"
  elif [ "$1" = rueckblick ]; then
    echo "plans/$(week_of "$d") Wochenrückblick.md"
  else
    echo "plans/$d Tagesplan.md"
  fi
}

# open_items <file>: numbered items in the review's "Zu entscheiden" section
open_items() {
  awk '/^## Zu entscheiden/ { on = 1; next }
       on && (/^## / || /^<!--/) { on = 0 }
       on && /^[0-9]+\. / { n++ }
       END { print n + 0 }' "$1"
}

success_message() {
  local d
  d=$(plan_day "$1")
  if [ "$1" = woche ]; then
    echo "Wochenplan KW $(week_number "$d") bereit"
  elif [ "$1" = rueckblick ]; then
    echo "Wochenrückblick KW $(week_number "$d") bereit ($(open_items "$(target_file rueckblick)") zu entscheiden)"
  else
    echo "Tagesplan für ${WEEKDAYS[$(date -j -f %F "$d" +%u)]}, $(date -j -f %F "$d" +%d.%m.) bereit"
  fi
}

# run_mode <mode>: one claude run; 0 if it (re)generated the plan file, or
# left a review alone that the owner already decided
run_mode() {
  local mode=$1 file gen rc=0
  local tools=("${TOOLS[@]}")
  [ "$mode" = rueckblick ] && tools=("${REVIEW_TOOLS[@]}")
  file=$(target_file "$mode")
  echo "=== $(date '+%F %T') $mode ===" >>"$TP_LOG"
  # caffeinate: launchd may start the run in a short dark wake; without an
  # assertion macOS sleeps again mid-run and connections go stale
  caffeinate -i perl -e 'alarm shift; exec @ARGV' "$TP_TIMEOUT" \
    "$TP_CLAUDE" -p "$(prompt_for "$mode")" \
    --permission-mode dontAsk --allowedTools "${tools[@]}" \
    >>"$TP_LOG" 2>&1 || rc=$?
  gen=$(sed -n 's/^generated: //p' "$file" 2>/dev/null | head -1)
  if [ "$rc" = 0 ] && [ -n "$gen" ] && ! [[ "$gen" < "$started" ]]; then
    notify "$(success_message "$mode")"
    return 0
  fi
  if [ "$rc" = 0 ] && [ "$mode" = rueckblick ] && grep -qx 'status: entschieden' "$file" 2>/dev/null; then
    notify "Wochenrückblick KW $(week_number "$(plan_day rueckblick)") bereits entschieden"
    return 0
  fi
  echo "tagesplanung-run: $mode failed (exit $rc, file: $file)" >>"$TP_LOG"
  notify "Tagesplanung ($mode) fehlgeschlagen, siehe Log"
  return 1
}

if [ $# -gt 0 ]; then
  case "$1" in
    heute | morgen | woche | rueckblick) modes=("$1") ;;
    *) echo "usage: tagesplanung-run [heute|morgen|woche|rueckblick]" >&2; exit 1 ;;
  esac
elif [ "$hour" -lt 12 ]; then
  modes=(heute); [ "$dow" = 1 ] && modes+=(rueckblick woche)
else
  modes=(morgen); [ "$dow" = 7 ] && modes+=(rueckblick woche)
fi

mkdir -p "$(dirname "$TP_LOG")"
trap trim_log EXIT
cd "$TP_VAULT"

ekread_rc=0
ekread calendars >/dev/null 2>>"$TP_LOG" || ekread_rc=$?
if [ "$ekread_rc" = 2 ]; then
  notify "Tagesplanung: macOS-Freigabe für ekread fehlt"
  exit 2
elif [ "$ekread_rc" != 0 ]; then
  echo "tagesplanung-run: ekread failed (exit $ekread_rc)" >>"$TP_LOG"
  notify "Tagesplanung: ekread-Fehler, siehe Log"
  exit 1
fi

status=0
for mode in "${modes[@]}"; do
  run_mode "$mode" || status=1
done
exit "$status"
