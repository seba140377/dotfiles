#!/usr/bin/env bash

#MISE description="Create a git worktree at <repo>.worktrees/<branch> (VS Code layout), show it in the VS Code workspace, open it in herdr, optionally hand it to Claude Code"
#MISE tools={jq="1.8"}
#USAGE arg "<branch>" help="Branch to check out; created from HEAD if it doesn't exist"
#USAGE flag "-o --open" help="Also open the worktree in a new VS Code window"
#USAGE flag "--carry <path>" var=#true help="Move an untracked file (plan, spec) into the worktree, same relative path"
#USAGE flag "--agent <prompt>" help="Start Claude Code in the left herdr pane and submit this prompt (needs herdr)"
# raw: redacted env vars (redact=true in a project) pipe task stdio, so gum finds no terminal.
#MISE raw=true

set -euo pipefail

# shellcheck source=lib/ui.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/ui.sh"
# shellcheck source=lib/vscode-workspace.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/vscode-workspace.sh"

# A global task starts outside the project; work in the directory mise was called from.
cd "${MISE_ORIGINAL_CWD:-$PWD}"

branch="$usage_branch"

# Always anchor on the main worktree, even when run from inside another worktree.
main_root=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
# Same layout as VS Code: sibling folder, slashes in the branch name become dashes.
path="${main_root}.worktrees/${branch//\//-}"

in_herdr=false
[[ ${HERDR_ENV:-} == 1 ]] && command -v herdr >/dev/null && in_herdr=true

header=("Creates the worktree $path.")
[[ -z ${usage_agent:-} ]] || header+=("Then Claude Code takes over in its left herdr pane.")
ui_header "worktree:add  $branch" "${header[@]}"
[[ ! -e $path ]] || ui_die "$path already exists."
[[ -z ${usage_agent:-} || $in_herdr == true ]] || ui_die "--agent needs a herdr session (HERDR_ENV=1)."

# Check every --carry file before anything is created: an untracked file of the
# calling checkout moves to the same relative path in the worktree; one that is
# committed unchanged is in the worktree already.
top=$(git rev-parse --show-toplevel)
carry=()
read -r -a carry_args <<<"${usage_carry:-}"
for arg in ${carry_args[@]+"${carry_args[@]}"}; do
  [[ $arg != \'* ]] || ui_die "--carry: paths with spaces are not supported ($arg)."
  [[ -f $arg ]] || ui_die "--carry: $arg is not a file."
  abs="$(cd "$(dirname "$arg")" && pwd -P)/$(basename "$arg")"
  [[ $abs == "$top"/* ]] || ui_die "--carry: $arg is outside $top."
  rel=${abs#"$top"/}
  if git -C "$top" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
    git -C "$top" diff --quiet HEAD -- "$rel" ||
      ui_die "--carry: $rel has uncommitted changes; commit or stash it first."
    ui_ok "$rel is committed; the worktree has it already"
  else
    carry+=("$rel")
  fi
done

if git show-ref --verify --quiet "refs/heads/$branch"; then
  git worktree add "$path" "$branch"
else
  git worktree add -b "$branch" "$path"
fi

for rel in ${carry[@]+"${carry[@]}"}; do
  mkdir -p "$(dirname "$path/$rel")"
  mv "$top/$rel" "$path/$rel"
  ui_ok "Moved $rel into the worktree"
done

# Keep files VS Code writes into a worktree (the --open task below, settings.json
# from extensions) out of git, so worktree:finish sees a clean checkout.
exclude="$(git rev-parse --git-common-dir)/info/exclude"
for pattern in /.vscode/tasks.json /.vscode/settings.json; do
  grep -qxF "$pattern" "$exclude" 2>/dev/null || echo "$pattern" >>"$exclude"
done

# Show <repo>.worktrees as a root folder in the VS Code workspace (Explorer).
vscode_ws_add "$main_root"

# Inside a herdr session, open the new worktree as its own herdr workspace:
# tab named after the branch, split into a left and a right pane; --agent
# starts Claude Code in the left one, the right one stays a shell.
left=""
if [[ $in_herdr == true ]]; then
  opened=$(herdr worktree open --cwd "$main_root" --path "$path" --focus)
  herdr tab rename "$(jq -r .result.tab.tab_id <<<"$opened")" "$branch" >/dev/null
  left=$(jq -r .result.root_pane.pane_id <<<"$opened")
  herdr pane split "$left" --direction right --cwd "$path" --no-focus >/dev/null
fi

if [[ ${usage_open:-false} == true ]]; then
  if command -v code >/dev/null; then
    # A folderOpen task opens the integrated terminal right away, running herdr
    # if it's installed, else a login shell.
    # VS Code may inherit HERDR_* from the pane it was launched in, and herdr
    # refuses to start nested while HERDR_ENV is set, so strip them.
    if command -v herdr >/dev/null; then
      cmd='"env"'
      args='["-u", "HERDR_ENV", "-u", "HERDR_PANE_ID", "-u", "HERDR_TAB_ID", "-u", "HERDR_WORKSPACE_ID", "herdr"]'
    else
      cmd='"${env:SHELL}"' args='["-l"]'
    fi
    mkdir -p "$path/.vscode"
    cat >"$path/.vscode/tasks.json" <<EOF
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "terminal",
      "type": "process",
      "command": $cmd,
      "args": $args,
      "options": { "cwd": "\${workspaceFolder}" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
EOF
    code --new-window "$path"
  else
    ui_warn "VS Code CLI 'code' not found; skipping --open."
  fi
fi

ui_ok "$path"

# --agent: Claude Code in the left pane gets the prompt. The pane's shell
# first runs the project's mise enter hook, and the first start in a new
# worktree asks whether to trust the folder, so wait generously. The prompt
# goes through `agent prompt`, not the command line, which macOS limits.
if [[ -n ${usage_agent:-} ]]; then
  [[ -n $left && $left != null ]] || ui_die "herdr returned no left pane; start Claude Code there yourself."
  name=$(tr '[:upper:]' '[:lower:]' <<<"$branch" | tr -c 'a-z0-9_\n-' '-')
  [[ $name == [a-z]* ]] || name="wt-$name"
  name=${name:0:32}
  # herdr refuses a pane whose shell is still starting (agent_pane_busy): retry.
  deadline=$((SECONDS + 300))
  until out=$(herdr agent start "$name" --kind claude --pane "$left" --timeout 300000 2>&1); do
    if [[ $out == *agent_pane_busy* ]] && ((SECONDS < deadline)); then
      sleep 1
    elif [[ $out == *agent_not_ready* ]]; then
      ui_warn "Claude Code is not ready yet; confirm its dialog (trust this folder?) in the left pane."
      break
    else
      ui_die "herdr could not start Claude Code in the left pane: $out"
    fi
  done
  herdr agent wait "$name" --until idle --timeout 600000 >/dev/null ||
    ui_die "Claude Code ($name) did not become ready; submit the prompt in the left pane yourself."
  herdr agent prompt "$name" "$usage_agent" >/dev/null
  ui_ok "Claude Code ($name) took over in the left pane of $branch"
fi
